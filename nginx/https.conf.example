# HTTPS version of nginx/default.conf. This file is NOT used as it is.
#
# Use it only after you have put fullchain.pem and privkey.pem in the certs/ folder
# (GUIDE.md, part 8). Then:
#   cp nginx/https.conf.example nginx/default.conf
#   and replace YOUR-NAME.example.com with your domain name (both server_name lines).

limit_req_zone $binary_remote_addr zone=api:10m rate=20r/s;

# Port 80: send every visitor to HTTPS.
server {
    listen 80;
    server_name YOUR-NAME.example.com;
    return 301 https://$host$request_uri;
}

# Port 443: the site over HTTPS.
server {
    listen 443 ssl;
    http2 on;
    server_name YOUR-NAME.example.com;
    server_tokens off;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Browsers use HTTPS only for this site. One day for now; raise it to 31536000
    # (one year) once HTTPS has worked for a few weeks.
    add_header Strict-Transport-Security "max-age=86400" always;

    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 1m;

    resolver 127.0.0.11 valid=10s ipv6=off;
    set $backend http://app:3000;

    gzip on;
    gzip_min_length 256;
    gzip_types text/css text/javascript application/javascript application/json text/plain;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 3s;
    proxy_read_timeout 60s;

    location /api/ {
        limit_req zone=api burst=40 nodelay;
        proxy_pass $backend;
    }

    location = /health {
        proxy_pass $backend;
    }

    location / {
        try_files $uri $uri/ =404;
        expires -1;
    }
}
