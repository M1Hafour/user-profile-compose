# Copy this file to .env and fill it in:   cp .env.example .env
# Never commit .env (it is in .gitignore).

# Database administrator user. Created the first time the database starts.
MONGO_USERNAME=appadmin

# A long random password. Any characters are fine.
MONGO_PASSWORD=change-me-to-a-long-random-password

# Name of the database the app uses.
MONGO_DB=user-profile

# nginx config to use. Leave this line out (plain HTTP) until HTTPS is set up by hand
# (GUIDE.md, part 8). Then set it to the file made on the server: ./nginx/https.conf
# NGINX_CONF=./nginx/https.conf
